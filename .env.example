GROQ_API_KEY=<your_groq_api_key_here>
GROQ_MODEL=llama-3.1-8b-instant

# Optional local fallback if GROQ_API_KEY is not set.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
MAX_CONTEXT_CHARS=110000
LLM_CONTEXT_TARGET_CHARS=18000
DIRECT_SECTION_OUTLINE_ANSWERS=true
SECTION_OUTLINE_DESCRIPTION_CHARS=520

VECTOR_DB_PATH=./vector_store
DOCUMENT_DIR=./data/documents
INGESTION_CACHE_PATH=./vector_store/ingestion_manifest.json
BM25_INDEX_PATH=./vector_store/bm25_index.pkl
COLLECTION_NAME=enterprise_rag

EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_SEQ_LENGTH=512
EMBEDDING_MAX_CHARS=2200
VECTOR_UPSERT_BATCH_SIZE=32
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu

# Higher-quality but slower local options:
# EMBEDDING_MODEL=BAAI/bge-m3
# RERANKER_MODEL=BAAI/bge-reranker-base

CHUNK_SIZE=900
CHUNK_OVERLAP=180
SMALL_CHUNK_SIZE=350
SMALL_CHUNK_OVERLAP=70
MIN_NATIVE_TEXT_CHARS=80
OCR_DPI=220
TOP_K_VECTOR=30
TOP_K_BM25=30
TOP_K_HYBRID=25
TOP_K_FINAL=5
SECTION_EXPANSION_MAX_PAGES=18
SECTION_EXPANSION_MAX_CHARS=100000
MIN_RETRIEVAL_CONFIDENCE=0.12
